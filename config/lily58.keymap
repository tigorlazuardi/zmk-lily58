#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <12 13>;
            layers = <0 4>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <0 1>;
            layers = <0 4>;
        };

        caps {
            bindings = <&kp CAPS>;
            key-positions = <36 49>;
            layers = <0>;
        };
    };

    behaviors {
        toggle_number_layer: toggle_number_layer {
            compatible = "zmk,behavior-tap-dance";
            label = "TOGGLE_NUMBER_LAYER";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT>, <&to 6>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  ENTER |  | SPACE | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4                &kp N5                                      &kp N6     &kp N7    &kp N8     &kp N9   &kp N0    &kp DELETE
&kp TAB    &kp Q   &kp W   &kp E   &kp R                 &kp T                                       &kp Y      &kp U     &kp I      &kp O    &kp P     &kp BACKSLASH
&kp LCTRL  &kp A   &kp S   &kp D   &kp F                 &kp G                                       &kp H      &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V                 &kp B         &to 4          &to 2          &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                           &mo 3   &toggle_number_layer  &kp LEFT_WIN  &lt 1 SPACE    &kp BACKSPACE  &kp ENTER  &kp BSPC  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            label = "Default";
        };

        symbol_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp TILDE         &kp F1          &kp F2          &kp F3          &kp F4          &kp F5                               &kp F6          &kp F7           &kp F8                &kp F9                 &kp F10           &kp F11
&kp GRAVE         &kp HOME        &kp UP_ARROW    &kp END         &kp F11         &kp F12                              &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&sk LEFT_CONTROL  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT       &none           &kp INS                              &kp COLON       &kp EQUAL        &kp MINUS             &kp UNDER              &kp PLUS          &kp DOUBLE_QUOTES
&sk LEFT_SHIFT    &none           &none           &none           &kp SCROLLLOCK  &kp PAUSE_BREAK  &kp F11    &kp F12  &kp PLUS        &none            &kp LESS_THAN         &kp GREATER_THAN       &kp QUESTION      &kp RIGHT_SHIFT
                                                  &studio_unlock  &none           &none            &none      &none    &none           &kp CAPS         &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            label = "Symbols";
        };

        mouse_layer {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4    &kp N5                           &kp N6          &kp N7           &kp N8          &kp N9           &kp N0    &none
&kp TAB    &kp Q   &kp W   &kp E   &kp R     &kp T                            &msc SCRL_UP    &mkp MB1         &mmv MOVE_UP    &mkp MB3         &mkp MB2  &none
&kp LCTRL  &kp A   &kp S   &kp D   &kp F     &kp G                            &msc SCRL_DOWN  &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none     &none
&kp LSHFT  &kp X   &kp Z   &kp C   &kp V     &kp B     &none        &to 0     &msc SCRL_LEFT  &msc SCRL_RIGHT  &none           &none            &none     &none
                           &none   &kp LALT  &kp LGUI  &kp SPACE    &mkp MB1  &mkp MB2        &none            &none
            >;

            label = "Mouse";
        };

        adjustment_layer {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                &kp C_VOLUME_UP  &kp C_PREV  &kp C_NEXT  &kp C_PLAY_PAUSE  &none  &kp C_BRIGHTNESS_INC
&none           &none         &none         &none         &none         &none                                       &kp C_VOL_DN     &none       &none       &none             &none  &kp C_BRIGHTNESS_DEC
&studio_unlock  &none         &none         &none         &none         &none                                       &kp C_MUTE       &none       &none       &none             &none  &none
&none           &none         &none         &none         &none         &none         &bt BT_CLR_ALL    &sys_reset  &none            &none       &none       &none             &none  &none
                                            &none         &none         &none         &none             &none       &none            &none       &none
            >;

            label = "Adjustment";
        };

        game_layer {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3        &kp N4        &kp N5                              &kp N6     &kp N7          &kp N8        &kp N9           &kp N0    &kp DELETE
&kp TAB    &kp Q   &kp W   &kp E         &kp R         &kp T                               &kp Y      &kp U           &kp UP_ARROW  &kp O            &kp P     &kp BACKSLASH
&kp LCTRL  &kp A   &kp S   &kp D         &kp F         &kp G                               &kp H      &kp LEFT_ARROW  &kp DOWN      &kp RIGHT_ARROW  &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C         &kp V         &kp B   &to 0        &none          &kp N      &kp M           &kp COMMA     &kp DOT          &kp FSLH  &kp RSHFT
                           &kp LEFT_WIN  &kp LEFT_ALT  &mo 5   &kp SPACE    &kp BACKSPACE  &kp ENTER  &none           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            label = "Game";
        };

        game_fn_layer {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                    &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans   &kp F12
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans   &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;

            label = "Game FN";
        };

        number_layer {
            bindings = <
&kp ESCAPE      &none  &none  &none  &none  &none                                &none      &none   &kp STAR  &none   &none      &none
&kp TAB         &none  &none  &none  &none  &none                                &kp PLUS   &kp N7  &kp N8    &kp N9  &kp MINUS  &none
&kp LCTRL       &none  &none  &none  &none  &none                                &kp N0     &kp N4  &kp N5    &kp N6  &kp N0     &none
&kp LEFT_SHIFT  &none  &none  &none  &none  &none         &none        &none     &kp EQUAL  &kp N1  &kp N2    &kp N3  &kp SLASH  &none
                              &to 0  &to 0  &kp LEFT_WIN  &kp SPACE    &kp BSPC  &kp ENTER  &none   &none
            >;

            label = "Numbers";
        };
    };
};
